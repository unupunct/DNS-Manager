<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DNSManagerPro.Core\DNSManagerPro.Core.csproj" />
    <ProjectReference Include="..\DNSManagerPro.Data\DNSManagerPro.Data.csproj" />
    <ProjectReference Include="..\DNSManagerPro.Networking\DNSManagerPro.Networking.csproj" />
    <ProjectReference Include="..\DNSManagerPro.Windows\DNSManagerPro.Windows.csproj" />
    <ProjectReference Include="..\DNSManagerPro.Infrastructure\DNSManagerPro.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DNSManagerPro</AssemblyName>
    <RootNamespace>DNSManagerPro.App</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <AssemblyTitle>DNS Manager Pro</AssemblyTitle>
    <Description>Switch, benchmark and troubleshoot DNS on Windows. Local only, no telemetry.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>


