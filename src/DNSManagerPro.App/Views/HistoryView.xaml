<UserControl x:Class="DNSManagerPro.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.RenderTransform><TranslateTransform /></UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,16,24">
            <DockPanel Margin="0,0,16,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="Export JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="History" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource CardStyle}" Padding="16,14">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding KindOptions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><RadioButton GroupName="hkind" Style="{StaticResource SegmentRadio}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,12,0,0">
                        <CheckBox DockPanel.Dock="Right" Content="Failures only" IsChecked="{Binding FailuresOnly}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <Grid DockPanel.Dock="Right" Width="240">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Search history..." Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding WindowOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><RadioButton GroupName="hwin" Style="{StaticResource SegmentRadio}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <DockPanel Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource DangerGhostButton}" Content="Delete selected" Command="{Binding DeleteSelectedCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource TableHeaderButton}" Content="Select all shown" Command="{Binding SelectAllShownCommand}" Margin="0,0,14,0" />
                            <Button Style="{StaticResource TableHeaderButton}" Content="Select none" Command="{Binding SelectNoneCommand}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" Margin="0,0,16,12" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers><DataTrigger Binding="{Binding MessageIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Nothing here yet. DNS changes, benchmarks, diagnostics and monitoring events will appear on this timeline." Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisible}}" />

            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,16,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Width="2" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" />
                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" Background="{StaticResource CardBrush}" BorderThickness="2" BorderBrush="{Binding Tone, Converter={StaticResource ToneBrush}}" VerticalAlignment="Top" Margin="0,10,0,0">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="2,16,0,0" ToolTip="Select" />
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="10,4,0,8" Padding="16,11">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TableHeaderButton}" Content="Details" Command="{Binding ToggleExpandedCommand}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}"
                                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

