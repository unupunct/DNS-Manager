<UserControl x:Class="DNSManagerPro.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
        <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
            <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,20,0,6" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
        <Border Background="#1F3347" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,16,0,0">
            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold">
                <Run Text="Planned for " /><Run Text="{Binding Phase, Mode=OneWay}" />
            </TextBlock>
        </Border>
    </StackPanel>
</UserControl>
