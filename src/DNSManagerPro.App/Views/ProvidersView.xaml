<UserControl x:Class="DNSManagerPro.App.Views.ProvidersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DNSManagerPro.App.Controls">
    <UserControl.RenderTransform><TranslateTransform /></UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,16,16">
            <DockPanel Margin="0,0,16,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Restore built-ins" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="+  Add provider" Command="{Binding AddCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="DNS Providers" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Public resolvers you can compare and apply. All fields are editable." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
            <Border Background="#1F3347" CornerRadius="8" Padding="12,8" Margin="0,10,16,16">
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                           Text="Changing an adapter's DNS server addresses configures plain DNS (UDP/TCP). It does not turn on DoH, DoT or DoQ - those are listed as provider capabilities only." />
            </Border>
            <TextBlock Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" Margin="0,0,16,12" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers><DataTrigger Binding="{Binding MessageIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><c:AdaptiveGrid MinColumnWidth="400" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{Binding IconBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="#0B1220" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource BadgeBorder}" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding KindText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" /></Border>
                                            <TextBlock Text="{Binding Provider.Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Provider.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Protocols}" Margin="0,14,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource BadgeBorder}"><TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="IPv4" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding IPv4Line}" FontFamily="Consolas" FontSize="12.5" />
                                    <TextBlock Grid.Row="1" Text="IPv6" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IPv6Line}" FontFamily="Consolas" FontSize="12.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding IPv6Line}" />
                                </Grid>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Quick Apply" IsEnabled="False" Margin="0,0,8,6" ToolTip="Applying DNS (with preview, backup and rollback) arrives in Phase 3." />
                                    <Button Style="{StaticResource GhostButton}" Content="Test Performance" Command="{Binding TestCommand}" Margin="0,0,8,6" />
                                    <Button Style="{StaticResource GhostButton}" Content="More Information" Command="{Binding ToggleInfoCommand}" Margin="0,0,0,6" />
                                </WrapPanel>
                                <TextBlock Text="{Binding TestResult}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Visibility="{Binding TestResult, Converter={StaticResource NullToCollapsed}}" Foreground="{StaticResource TextBrush}" />
                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                                    <TextBlock Text="Website" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Provider.Website}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="Privacy" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Provider.Privacy}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="Security features" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Provider.Security}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="Filtering" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Provider.Filtering}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="Encrypted DNS endpoints" Style="{StaticResource MutedText}" />
                                    <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12">
                                        <Run Text="DoH: " /><Run Text="{Binding Provider.DohUrl, Mode=OneWay, TargetNullValue=-}" /><LineBreak />
                                        <Run Text="DoT: " /><Run Text="{Binding Provider.DotHost, Mode=OneWay, TargetNullValue=-}" /><LineBreak />
                                        <Run Text="DoQ: " /><Run Text="{Binding Provider.DoqHost, Mode=OneWay, TargetNullValue=-}" />
                                    </TextBlock>
                                    <TextBlock Text="Notes" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Provider.Notes}" Margin="0,0,0,12" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" Text="Provider details are maintained by hand and may be out of date; check the provider's website." />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource DangerGhostButton}" Content="Delete" Command="{Binding DeleteCommand}" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
