<UserControl x:Class="DNSManagerPro.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.RenderTransform><TranslateTransform /></UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,16,24" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Margin="0,0,16,14">
                <TextBlock Text="About" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Version, licenses and project information." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="64" Height="64" CornerRadius="16" Background="#1F3347" VerticalAlignment="Top">
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="DNS Manager Pro" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                            <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Runtime}" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding Copyright}" Style="{StaticResource MutedText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Project page on GitHub" Command="{Binding OpenProjectCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource GhostButton}" Content="Copy version details" Command="{Binding CopyDiagnosticsCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="PRINCIPLES" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Principles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0">
                        <Run Text="Your data (database, settings, logs) is stored only in " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="OPEN-SOURCE COMPONENTS" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Licenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Purpose}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding License}" Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="DNS Manager Pro itself is released under the MIT License. Provider names belong to their owners; this project is not affiliated with them." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
