<Application x:Class="DNSManagerPro.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DNSManagerPro.App.ViewModels"
             xmlns:views="clr-namespace:DNSManagerPro.App.Views"
             xmlns:conv="clr-namespace:DNSManagerPro.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:ToneBrushConverter x:Key="ToneBrush" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <conv:EnumToBoolConverter x:Key="EnumToBool" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <DataTemplate x:Key="InfoRowTemplate">
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProvidersViewModel}">
                <views:ProvidersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}">
                <views:BenchmarkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdaptersViewModel}">
                <views:AdaptersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>



