<Window x:Class="DNSManagerPro.App.Dialogs.ApplyDnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:DNSManagerPro.App.Dialogs"
        Title="{Binding Title}" Width="700" Height="800" MinHeight="560" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource GhostButton}" Command="{Binding CloseCommand}" IsCancel="True" Margin="0,0,10,0" MinWidth="90" />
                <Button Content="{Binding PrimaryText}" Style="{StaticResource PrimaryButton}" Command="{Binding PrimaryCommand}" MinWidth="150" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,16">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Review exactly what will change. Nothing is modified until you press the button below." Style="{StaticResource MutedText}" Margin="0,4,0,14" TextWrapping="Wrap" />

                <Border Background="#33F59E0B" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                        Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap" FontSize="12.5"
                               Text="Administrator rights are required: Windows only allows administrators to change DNS settings. 'Restart as administrator' shows the Windows prompt and reopens this review; nothing is changed until you apply again." />
                </Border>

                <TextBlock Text="ADAPTER" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding AdapterOptions}" SelectedItem="{Binding SelectedAdapter}" IsEnabled="{Binding CanEdit}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardListItemStyle}" MaxHeight="190">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="IPV4 DNS" Style="{StaticResource CardTitle}" Margin="0,14,0,6" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="V4" Style="{StaticResource SegmentRadio}" Content="Leave unchanged"  IsEnabled="{Binding CanEdit}" IsChecked="{Binding ChoiceV4, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static d:FamilyChoice.Unchanged}}" />
                    <RadioButton GroupName="V4" Style="{StaticResource SegmentRadio}" Content="{Binding SourceLabel}" Visibility="{Binding HasSourceV4, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEdit}" IsChecked="{Binding ChoiceV4, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static d:FamilyChoice.Source}}" />
                    <RadioButton GroupName="V4" Style="{StaticResource SegmentRadio}" Content="Automatic (DHCP)"  IsEnabled="{Binding CanEdit}" IsChecked="{Binding ChoiceV4, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static d:FamilyChoice.Automatic}}" />
                </StackPanel>
                <TextBlock Text="IPV6 DNS" Style="{StaticResource CardTitle}" Margin="0,14,0,6" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="V6" Style="{StaticResource SegmentRadio}" Content="Leave unchanged"  IsEnabled="{Binding CanEdit}" IsChecked="{Binding ChoiceV6, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static d:FamilyChoice.Unchanged}}" />
                    <RadioButton GroupName="V6" Style="{StaticResource SegmentRadio}" Content="{Binding SourceLabel}" Visibility="{Binding HasSourceV6, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanEdit}" IsChecked="{Binding ChoiceV6, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static d:FamilyChoice.Source}}" />
                    <RadioButton GroupName="V6" Style="{StaticResource SegmentRadio}" Content="Automatic (DHCP)"  IsEnabled="{Binding CanEdit}" IsChecked="{Binding ChoiceV6, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static d:FamilyChoice.Automatic}}" />
                </StackPanel>

                <TextBlock Text="PREVIEW" Style="{StaticResource CardTitle}" Margin="0,18,0,6" />
                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="16,14">
                    <ItemsControl ItemsSource="{Binding Preview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Before}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextDecorations="{x:Null}" />
                                        <TextBlock Text="{Binding After, StringFormat='-> {0}'}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Changes}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="A backup of the current settings is saved first. If the change fails, cannot be verified, or the new server does not answer, your previous settings are restored automatically." />

                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,4" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Problems}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,4" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path=., StringFormat='  {0}'}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ResultMessage}" Visibility="{Binding ResultMessage, Converter={StaticResource NullToCollapsed}}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers><DataTrigger Binding="{Binding ResultIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

