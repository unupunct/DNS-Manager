<Window x:Class="DNSManagerPro.App.Dialogs.ProviderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="620" Height="760" MinHeight="520" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,10,0" MinWidth="90" />
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="90" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Errors}" VerticalAlignment="Center" MaxHeight="64">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource ErrorBrush}" FontSize="12" TextTrimming="CharacterEllipsis" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,12">
                <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <StackPanel Margin="0,0,0,12"><TextBlock Text="Name" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="" /></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Text="Description" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" /></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Text="Website" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" ToolTip="" /></StackPanel>
                <TextBlock Text="TRADITIONAL DNS SERVERS (IP addresses)" Style="{StaticResource CardTitle}" Margin="0,8,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="IPv4 primary" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Ipv4Primary, UpdateSourceTrigger=PropertyChanged}" ToolTip="" /></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="IPv4 secondary" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Ipv4Secondary, UpdateSourceTrigger=PropertyChanged}" ToolTip="" /></StackPanel></StackPanel>
                    <StackPanel Grid.Column="2"><StackPanel Margin="0,0,0,12"><TextBlock Text="IPv6 primary" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Ipv6Primary, UpdateSourceTrigger=PropertyChanged}" ToolTip="" /></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="IPv6 secondary" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Ipv6Secondary, UpdateSourceTrigger=PropertyChanged}" ToolTip="" /></StackPanel></StackPanel>
                </Grid>
                <TextBlock Text="ENCRYPTED DNS ENDPOINTS (informational)" Style="{StaticResource CardTitle}" Margin="0,8,0,4" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Applying IP addresses to an adapter configures plain DNS only. It does not enable DoH, DoT or DoQ; these endpoints are stored for reference and for benchmark comparisons." />
                <StackPanel Margin="0,0,0,12"><TextBlock Text="DoH URL (https://...)" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding DohUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="" /></StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="DoT host" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding DotHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="" /></StackPanel></StackPanel>
                    <StackPanel Grid.Column="2"><StackPanel Margin="0,0,0,12"><TextBlock Text="DoQ host" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding DoqHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="" /></StackPanel></StackPanel>
                </Grid>
                <TextBlock Text="DETAILS" Style="{StaticResource CardTitle}" Margin="0,8,0,8" />
                <StackPanel Margin="0,0,0,12"><TextBlock Text="Privacy" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Privacy, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" /></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Text="Security features" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Security, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" /></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Text="Filtering" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Filtering, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" /></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Text="Notes" Style="{StaticResource MutedText}" Margin="0,0,0,4" /><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" /></StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
